<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Editor Formatting and List Checks" parallel="none" thread-count="1">
    <listeners>
        <listener class-name="b_utilities.ExtentReportManager" />
        <listener class-name="b_utilities.AnnotationTransfer" />
    </listeners>
    <parameter name="browser" value="chrome" />
    <test name="TC_25 to TC_29">
        <classes>
            <class name="e_testCases.Ab_DocumentEditorTC">
                <methods>
                    <include name="verifyApplyingItalicToHeadingWord" />
                    <include name="verifyApplyingUnderlineToHeadingWord" />
                    <include name="verifyRedoRestoresBoldFormatting" />
                    <include name="verifyApplyingUnorderedListToParagraph" />
                    <include name="verifyApplyingOrderedListToParagraph" />
                </methods>
            </class>
        </classes>
    </test>
</suite>
