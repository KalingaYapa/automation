<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Document Editor" parallel="none" thread-count="1">
    <listeners>
        <listener class-name="b_utilities.ExtentReportManager" />
        <listener class-name="b_utilities.AnnotationTransfer" />
    </listeners>
    <parameter name="browser" value="chrome" />
    <test name="RetryMultipleFailedTestcases">
        <groups>
            <run>
                <include name="DocumentEditor" />
                <include name="Para" />
                <include name="P1-Para" />
                <include name="P2-Para" />
                <include name="P3-Para" />
                <include name="P4-Para" />
            </run>
        </groups>
        <classes>
            <class name="documenteditor.DocumentEditor1TestCase" />
            <class name="para.Para1TestCase" />
        </classes>
    </test>
</suite>
