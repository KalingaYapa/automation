<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Sandbox Portal Navigation" parallel="none" thread-count="1">
    <listeners>
        <listener class-name="b_utilities.ExtentReportManager" />
        <listener class-name="b_utilities.AnnotationTransfer" />
    </listeners>
    <parameter name="browser" value="chrome" />
    <test name="RetryMultipleFailedTestcases">
        <groups>
            <run>
                <include name="Portal" />
            </run>
        </groups>
        <classes>
            <class name="portal.Portal1TestCase" />
        </classes>
    </test>
</suite>
